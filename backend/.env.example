# =========================================================================
# PLANTILLA DE CONFIGURACIÓN DE OPSO
#
# Copia este archivo como ".env" y completa los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore):
# contiene contraseñas reales.
#
# Para generar una SECRET_KEY nueva:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# =========================================================================

# --- Django ---
DJANGO_SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos PostgreSQL ---
DB_ENGINE=postgresql
DB_NAME=opso_db
DB_USER=opso_user
DB_PASSWORD=reemplazar-por-la-clave-de-la-base-de-datos
DB_HOST=localhost
DB_PORT=5432

# --- Seguridad (desarrollo local sin HTTPS) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USAR_MANIFIESTO_ESTATICOS=False

# --- Reglas de acceso de OPSO ---
OPSO_INTENTOS_MAXIMOS_LOGIN=5
OPSO_BLOQUEO_LOGIN_MINUTOS=15
OPSO_INACTIVIDAD_MINUTOS=30

# =========================================================================
# CORREO ELECTRÓNICO (recuperación de contraseña)
# =========================================================================
#
# DESARROLLO: el backend de consola imprime el correo completo en la terminal
# donde corre runserver, con el enlace listo para copiar. No requiere cuenta
# de correo, ni internet, ni configuración adicional.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# PRODUCCIÓN: descomentar la línea siguiente y completar los datos SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Servidor SMTP ---
# Gmail:    smtp.gmail.com    puerto 587 con TLS
# Outlook:  smtp.office365.com puerto 587 con TLS
# Mailtrap: sandbox.smtp.mailtrap.io puerto 2525 (recomendado para pruebas)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# --- Credenciales de la cuenta que envía ---
# IMPORTANTE con Gmail: NO uses tu contraseña personal. Google la rechaza
# desde 2022. Debes activar la verificación en dos pasos y generar una
# "contraseña de aplicación" de 16 caracteres en:
#   https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Remitente visible para el usuario ---
DEFAULT_FROM_EMAIL=OPSO - Operativo Social <no-responder@opso.cl>

# --- Identidad del sistema en los correos ---
OPSO_NOMBRE_SISTEMA=OPSO
OPSO_CORREO_SOPORTE=soporte@opso.cl

# =========================================================================
# RECUPERACIÓN DE CONTRASEÑA
# =========================================================================

# Vigencia del enlace, en SEGUNDOS. 3600 = 1 hora.
# (El valor por defecto de Django son 3 días: aquí se reduce a propósito.)
PASSWORD_RESET_TIMEOUT=3600

# Límite de solicitudes para evitar el abuso del formulario.
OPSO_MAX_SOLICITUDES_RECUPERACION=3
OPSO_MAX_SOLICITUDES_RECUPERACION_IP=10
OPSO_VENTANA_RECUPERACION_MINUTOS=15

# --- Caché (control de frecuencia) ---
# En producción con varios procesos, reemplazar por Redis:
#   CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   CACHE_LOCATION=redis://127.0.0.1:6379/1
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=opso-cache-local
